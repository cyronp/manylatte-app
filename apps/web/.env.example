# VITE_API_MODE values: local uses VITE_LOCAL_API_URL; forwarded uses VITE_FORWARDED_API_URL.
VITE_API_MODE=local
VITE_LOCAL_API_URL=http://localhost:3000
VITE_FORWARDED_API_URL=https://your-forwarded-api-url.example

# Keep the dev server local by default. For LAN or tunnel access, bind explicitly
# and list only hostnames you control.
DEV_SERVER_HOST=127.0.0.1
# DEV_SERVER_ALLOWED_HOSTS=your-tunnel-host.example
