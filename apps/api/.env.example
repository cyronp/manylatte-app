PORT=3000
DATABASE_URL=file:./prisma/manylatte.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum persisted lobbies, including archives. Remove archived lobbies explicitly to reclaim capacity.
MAX_LOBBIES=10000

# Socket abuse and resource limits.
CURSOR_CONNECTION_IDLE_TIMEOUT_MS=300000
CURSOR_MAX_CONNECTIONS_PER_IP=20
CURSOR_MAX_PARTICIPANTS_PER_ROOM=100
CURSOR_MAX_TOTAL_CONNECTIONS=1000
SOCKET_MAX_HTTP_BUFFER_BYTES=32768

# Native WebRTC discovery. Set empty for local-network-only operation.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# Optional Coturn-compatible relay for restrictive networks. Keep the shared
# secret server-side; the API issues temporary credentials to lobby members.
# WEBRTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Generate a random 32-byte secret (64 hex characters); see deploy/turnserver.conf.example.
# WEBRTC_TURN_SECRET=<generated-secret>

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
# Comma-separated trusted proxy IPs/CIDRs, or false. Never trust all hops.
# TRUST_PROXY=127.0.0.1/32,::1/128
TRUST_PROXY=false

# SQLite currently supports one API instance. REDIS_URL must be unset.
