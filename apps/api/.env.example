PORT=3000
DATABASE_URL=file:./prisma/manylatte.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Socket abuse and resource limits.
CURSOR_CONNECTION_IDLE_TIMEOUT_MS=300000
CURSOR_MAX_CONNECTIONS_PER_IP=20
CURSOR_MAX_PARTICIPANTS_PER_ROOM=100
CURSOR_MAX_TOTAL_CONNECTIONS=1000
SOCKET_MAX_HTTP_BUFFER_BYTES=4096

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=false

# SQLite currently supports one API instance. REDIS_URL must be unset.
