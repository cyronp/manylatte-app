generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lobby {
  id        String   @id
  ownerId   String?
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  archivedAt DateTime?
  lastActivityAt DateTime @default(now())
  nodes CanvasNode[]
  operations CanvasOperation[]
  bans LobbyBan[]
  @@index([archivedAt, lastActivityAt])
}

model LobbyBan {
  roomId String
  userId String
  room Lobby @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([roomId, userId])
}

model CanvasNode {
  id             String          @id
  roomId         String
  room           Lobby @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type           String
  x              Float
  y              Float
  emoji          String?
  label          String?
  authorId       String?
  authorUsername String?
  authorColor    String?
  messageCount   Int             @default(0)
  textBytes      Int             @default(0)
  createdAt      DateTime        @default(now())
  messages       CanvasMessage[]

  @@index([roomId, createdAt, id])
}

model CanvasMessage {
  sequence       Int        @id @default(autoincrement())
  id             String     @unique
  nodeId         String
  node           CanvasNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  text           String
  authorId       String
  authorUsername String
  authorColor    String
  createdAt      DateTime   @default(now())

  @@index([nodeId, sequence])
}

model CanvasOperation {
  roomId    String
  room      Lobby @relation(fields: [roomId], references: [id], onDelete: Cascade)
  id        String
  hash      String
  result    String
  createdAt DateTime @default(now())

  @@id([roomId, id])
  @@index([createdAt])
}
